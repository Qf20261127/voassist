diff --git a/Sources/BoostCore/SharedSettings.swift b/Sources/BoostCore/SharedSettings.swift
index 375744f..7f6d1ee 100644
--- a/Sources/BoostCore/SharedSettings.swift
+++ b/Sources/BoostCore/SharedSettings.swift
@@ -184,6 +184,21 @@ public struct VoiceEntry: Codable, Equatable, Hashable {
         appleID.hasPrefix("com.apple.") && !appleID.contains(".speech.synthesis.voice.") // novelty voices (Bells, Bubbles ...)
     }
 
+    /// The same voice under the other quality tiers: `super-compact` on some systems, `compact` on others (an iPhone
+    /// with only the compact Chinese voice has `com.apple.voice.compact.zh-CN.Tingting` and no super-compact one).
+    /// Looked up in order, so a hard-coded identifier still finds the voice the device actually has.
+    public func candidateIDs() -> [String] {
+        let tiers = ["super-compact", "compact", "premium", "enhanced"]
+        var result = [id]
+        for from in tiers where id.contains(".\(from).") {
+            for to in tiers where to != from {
+                let alt = id.replacingOccurrences(of: ".\(from).", with: ".\(to).")
+                if !result.contains(alt) { result.append(alt) }
+            }
+        }
+        return result
+    }
+
     // The built-in ("super-compact") voices: the only kind the voice extension can use (see `UsableVoices`).
     public static let tingting = VoiceEntry(id: "com.apple.voice.super-compact.zh-CN.Tingting", name: "婷婷", lang: "zh-CN")
     public static let samantha = VoiceEntry(id: "com.apple.voice.super-compact.en-US.Samantha", name: "Samantha", lang: "en-US")
diff --git a/Sources/BoostCore/SystemVoice.swift b/Sources/BoostCore/SystemVoice.swift
index 1cf23a0..21f68cb 100644
--- a/Sources/BoostCore/SystemVoice.swift
+++ b/Sources/BoostCore/SystemVoice.swift
@@ -231,9 +231,31 @@ public final class SystemVoice {
     /// third-party voice: that would be a provider again (this very extension, at worst).
     public func resolve(_ entry: VoiceEntry) -> AVSpeechSynthesisVoice? {
         if let v = cache[entry.id] { return v }
-        var v = AVSpeechSynthesisVoice(identifier: entry.id)
-        if v == nil || !VoiceEntry.isWrappable(v!.identifier) { v = AVSpeechSynthesisVoice(language: entry.lang) }
-        guard let voice = v, VoiceEntry.isWrappable(voice.identifier) else { return nil }
+        var found: AVSpeechSynthesisVoice?
+        // 1. the identifier itself, then the same voice under the other quality tiers (super-compact / compact / ...).
+        for cid in entry.candidateIDs() {
+            if let v = AVSpeechSynthesisVoice(identifier: cid), VoiceEntry.isWrappable(v.identifier) {
+                found = v
+                break
+            }
+        }
+        // 2. the list the extension reported through `fullState`: the voices this sandbox really has.
+        //    (Read here, not cached: an extension may start before the shared container is first unlocked.)
+        if found == nil, let list = UsableVoices.load(),
+           let match = list.first(where: { $0.lang == entry.lang && VoiceEntry.isWrappable($0.id) }),
+           let v = AVSpeechSynthesisVoice(identifier: match.id), VoiceEntry.isWrappable(v.identifier) {
+            found = v
+        }
+        // 3. the language's default system voice.
+        if found == nil, let v = AVSpeechSynthesisVoice(language: entry.lang), VoiceEntry.isWrappable(v.identifier) {
+            found = v
+        }
+        if found == nil {
+            DiagnosticLog.write("voice lookup \(entry.id) [\(entry.lang)]: none of \(entry.candidateIDs().count) candidates, not in the reported list, no default")
+        } else {
+            DiagnosticLog.write("voice lookup \(entry.id) [\(entry.lang)] -> \(found!.identifier)")
+        }
+        guard let voice = found else { return nil }
         cache[entry.id] = voice
         return voice
     }
